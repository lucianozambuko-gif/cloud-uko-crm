{
  "name": "clouduko-crm",
  "version": "1.0.0",
  "description": "Cloud Uko CRM - clients, projects, tasks, quotes, invoices and recurring billing",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "import-seed": "node --env-file-if-exists=.env scripts/import-seed.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "ejs": "^7.0.1",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "pdfkit": "^0.20.2"
  }
}
