# All optional - the CRM runs without a .env file.

# Port and interface to listen on. 0.0.0.0 = reachable from other devices
# (Wi-Fi and Tailscale). Use 127.0.0.1 to allow this PC only.
PORT=3000
HOST=0.0.0.0

# Address the desktop shortcut opens. Leave unset for http://localhost:PORT.
# Set it to your Tailscale HTTPS address to use the same address as your phone.
# APP_URL=https://your-pc.your-tailnet.ts.net

# Where the database, backups, logo and session secret live.
# DATA_DIR=./data

# Leave unset to use the local file in DATA_DIR. Set both to move to Turso.
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=

# Leave unset and one is generated into DATA_DIR on first start.
# SESSION_SECRET=
