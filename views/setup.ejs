<%- include('partials/head') %>
<div class="card narrow">
  <h1>Create your login</h1>
  <p class="muted">This is the only account on this CRM. You can change the password later under Settings.</p>
  <form method="post" action="/setup" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>Username
      <input type="text" name="username" value="<%= username %>" autocomplete="username" required autofocus>
    </label>
    <label>Password (at least 10 characters)
      <input type="password" name="password" autocomplete="new-password" minlength="10" required>
    </label>
    <label>Repeat password
      <input type="password" name="confirm" autocomplete="new-password" minlength="10" required>
    </label>
    <button class="btn primary" type="submit">Create login</button>
  </form>
</div>
<%- include('partials/foot') %>
