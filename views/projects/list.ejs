<%- include('../partials/head') %>
<div class="page-head">
  <h1>Projects</h1>
  <div class="actions">
    <a class="btn primary" href="/projects/new">New project</a>
  </div>
</div>

<div class="tabs">
  <% for (const [key, label] of Object.entries(views)) { %>
    <a href="/projects<%= key === 'all' ? '' : '?view=' + key %>" class="<%= view === key ? 'active' : '' %>"><%= label %></a>
  <% } %>
</div>

<section class="card">
  <% if (!projects.length) { %>
    <p class="muted">No projects here.</p>
  <% } else { %>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Project</th><th>Client</th><th>Stage</th><th>Progress</th><th>Target</th><th>Links</th></tr></thead>
      <tbody>
      <% for (const p of projects) { const demo = pj.href(p.demo_url); const live = pj.href(p.url); %>
        <tr class="<%= p.state === 'open' ? '' : 'faded' %>">
          <td><a href="/projects/<%= p.id %>"><%= p.name %></a><% if (p.type) { %><div class="muted small-text"><%= p.type %></div><% } %></td>
          <td><a href="/clients/<%= p.client_id %>"><%= p.client_name %></a></td>
          <td><%- include('../partials/stage-badge', { p }) %></td>
          <td><%- include('../partials/progress', { p }) %></td>
          <td><%= p.target_date ? f.fmtDate(p.target_date) : '' %></td>
          <td>
            <% if (demo) { %><a href="<%= demo %>" target="_blank" rel="noopener noreferrer">Demo</a><% } %>
            <% if (live) { %><a href="<%= live %>" target="_blank" rel="noopener noreferrer">Live</a><% } %>
          </td>
        </tr>
      <% } %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>
<%- include('../partials/foot') %>
