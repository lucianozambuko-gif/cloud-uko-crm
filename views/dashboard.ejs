<%- include('partials/head') %>
<div class="page-head">
  <h1>Dashboard</h1>
  <div class="actions">
    <a class="btn" href="/clients/new">New client</a>
    <a class="btn primary" href="/invoices/new">New invoice</a>
  </div>
</div>

<div class="stats">
  <div class="stat"><span>Billed in <%= f.fmtMonth(today) %></span><strong><%= f.money(billed) %></strong></div>
  <div class="stat"><span>Received in <%= f.fmtMonth(today) %></span><strong><%= f.money(received) %></strong></div>
  <div class="stat"><span>Outstanding (all invoices)</span><strong><%= f.money(outstandingTotal) %></strong></div>
  <div class="stat <%= overdueCount ? 'warn' : '' %>"><span>Overdue invoices</span><strong><%= overdueCount %></strong></div>
</div>

<section class="card">
  <h2>Outstanding invoices</h2>
  <% if (!outstanding.length) { %>
    <p class="muted">Nothing outstanding.</p>
  <% } else { %>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Invoice</th><th>Client</th><th>Due</th><th class="num">Total</th><th class="num">Paid</th><th class="num">Outstanding</th><th>Status</th></tr></thead>
      <tbody>
      <% for (const d of outstanding) { const s = f.docState(d); %>
        <tr>
          <td><a href="/invoices/<%= d.id %>"><%= d.number %></a></td>
          <td><a href="/clients/<%= d.client_id %>"><%= d.client_name %></a></td>
          <td><%= f.fmtDate(d.due_date) %></td>
          <td class="num"><%= f.money(d.total_cents) %></td>
          <td class="num"><%= f.money(d.paid_cents) %></td>
          <td class="num"><strong><%= f.money(d.total_cents - d.paid_cents) %></strong></td>
          <td><span class="badge <%= s.cls %>"><%= s.label %></span></td>
        </tr>
      <% } %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>

<section class="card">
  <div class="card-head">
    <h2>Projects in progress</h2>
    <a class="btn small" href="/projects/new">New project</a>
  </div>
  <% if (!projects.length) { %>
    <p class="muted">Nothing in progress. <a href="/projects?view=live">See live projects</a></p>
  <% } else { %>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Project</th><th>Client</th><th>Stage</th><th>Progress</th><th>Target</th></tr></thead>
      <tbody>
      <% for (const p of projects) { %>
        <tr>
          <td><a href="/projects/<%= p.id %>"><%= p.name %></a></td>
          <td><a href="/clients/<%= p.client_id %>"><%= p.client_name %></a></td>
          <td><%- include('partials/stage-badge', { p }) %></td>
          <td><%- include('partials/progress', { p }) %></td>
          <td class="<%= p.target_date && p.target_date < today ? 'late' : '' %>"><%= p.target_date ? f.fmtDate(p.target_date) : '' %></td>
        </tr>
      <% } %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>

<div class="two-col">
  <section class="card">
    <h2>Recurring billing due in the next 30 days</h2>
    <% if (!recurring.length) { %>
      <p class="muted">Nothing due.</p>
    <% } else { %>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Client</th><th>Service</th><th>Next</th><th class="num">Amount</th></tr></thead>
        <tbody>
        <% for (const r of recurring) { %>
          <tr>
            <td><a href="/clients/<%= r.client_id %>"><%= r.client_name %></a></td>
            <td><%= r.description %></td>
            <td><%= f.fmtDate(r.next_date) %><% if (r.next_date <= today) { %> <span class="badge overdue">Due</span><% } %></td>
            <td class="num"><%= f.money(r.amount_cents) %></td>
          </tr>
        <% } %>
        </tbody>
      </table>
    </div>
    <p><a href="/recurring">Go to recurring billing</a></p>
    <% } %>
  </section>

  <section class="card">
    <h2>Follow-up tasks</h2>
    <% if (!tasks.length) { %>
      <p class="muted">No open tasks.</p>
    <% } else { %>
    <ul class="tasks">
      <% for (const t of tasks) { %>
        <li>
          <form method="post" action="/tasks/<%= t.id %>/toggle">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <input type="hidden" name="back" value="/">
            <button class="check" type="submit" title="Mark as done" aria-label="Mark as done"></button>
          </form>
          <div>
            <%= t.title %>
            <%- include('partials/task-meta', { t, showClient: true }) %>
          </div>
        </li>
      <% } %>
    </ul>
    <% } %>
    <p><a href="/tasks">All tasks</a></p>
  </section>
</div>

<section class="card">
  <div class="card-head">
    <h2>Automation</h2>
    <form method="post" action="/settings/run-automation">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="back" value="/">
      <button class="btn small" type="submit">Run now</button>
    </form>
  </div>
  <% if (!automation.length) { %>
    <p class="muted">Nothing has needed doing yet. Recurring invoices, renewal reminders and follow-ups will be listed here.</p>
  <% } else { %>
    <ul class="log">
      <% for (const a of automation) { %>
        <li>
          <span class="muted small-text"><%= f.fmtDate(a.created_at.slice(0, 10)) %></span>
          <% if (a.link) { %><a href="<%= a.link %>"><%= a.message %></a><% } else { %><%= a.message %><% } %>
        </li>
      <% } %>
    </ul>
  <% } %>
  <p class="muted small-text">
    Checks run when the CRM starts and every hour while it is open.
    <% if (settings.automation_last_run) { %>Last check: <%= f.fmtDateTime(settings.automation_last_run) %>.<% } %>
    <a href="/settings#automation">Change the rules</a>
  </p>
</section>
<%- include('partials/foot') %>
