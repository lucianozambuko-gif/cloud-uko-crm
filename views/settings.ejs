<%- include('partials/head') %>
<div class="page-head"><h1>Settings</h1></div>

<form method="post" action="/settings" class="card form">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <h2>Business details (printed on quotes and invoices)</h2>
  <div class="grid">
    <label>Business name *
      <input type="text" name="business_name" value="<%= values.business_name %>" maxlength="120" required>
    </label>
    <label>Registration number
      <input type="text" name="business_reg_number" value="<%= values.business_reg_number %>" maxlength="40">
    </label>
    <label>Phone
      <input type="tel" name="business_phone" value="<%= values.business_phone %>" maxlength="40">
    </label>
    <label>Email
      <input type="email" name="business_email" value="<%= values.business_email %>" maxlength="160">
    </label>
    <label>Website
      <input type="text" name="business_website" value="<%= values.business_website %>" maxlength="160">
    </label>
  </div>
  <label>Address
    <textarea name="business_address" rows="3" maxlength="500"><%= values.business_address %></textarea>
  </label>

  <h2>VAT</h2>
  <label class="check-label">
    <input type="checkbox" name="vat_registered" value="1" <%= values.vat_registered === '1' ? 'checked' : '' %>> Cloud Uko is VAT registered (adds VAT to new quotes and invoices)
  </label>
  <div class="grid">
    <label>VAT number
      <input type="text" name="vat_number" value="<%= values.vat_number %>" maxlength="30">
    </label>
    <label>VAT rate (%)
      <input type="text" name="vat_rate" value="<%= values.vat_rate %>" inputmode="decimal">
    </label>
  </div>

  <h2>Numbering and terms</h2>
  <div class="grid">
    <label>Invoice prefix (e.g. CU-INV gives CU-INV-2026-001)
      <input type="text" name="invoice_prefix" value="<%= values.invoice_prefix %>" maxlength="12" required>
    </label>
    <label>Quote prefix
      <input type="text" name="quote_prefix" value="<%= values.quote_prefix %>" maxlength="12" required>
    </label>
    <label>Payment terms (days until an invoice is due)
      <input type="text" name="payment_terms_days" value="<%= values.payment_terms_days %>" inputmode="numeric" required>
    </label>
    <label>Quotes valid for (days)
      <input type="text" name="quote_valid_days" value="<%= values.quote_valid_days %>" inputmode="numeric" required>
    </label>
  </div>
  <label>Banking details (printed on invoices)
    <textarea name="bank_details" rows="4" maxlength="1000" placeholder="Bank, account name, account number, branch code"><%= values.bank_details %></textarea>
  </label>
  <label>Footer text (printed at the bottom of quotes and invoices)
    <textarea name="document_footer" rows="2" maxlength="1000"><%= values.document_footer %></textarea>
  </label>

  <h2 id="automation">Automation</h2>
  <p class="muted small-text">Checks run when the CRM starts and every hour while it is open. Enter 0 days to switch a rule off.</p>
  <div class="grid">
    <label>Recurring services on their billing date
      <select name="auto_invoice_mode">
        <option value="draft" <%= values.auto_invoice_mode === 'draft' ? 'selected' : '' %>>Create a draft invoice for me to check</option>
        <option value="sent" <%= values.auto_invoice_mode === 'sent' ? 'selected' : '' %>>Create the invoice as sent straight away</option>
        <option value="off" <%= values.auto_invoice_mode === 'off' ? 'selected' : '' %>>Do nothing (I use the buttons)</option>
      </select>
    </label>
    <label>Remind me this many days before a yearly renewal
      <input type="text" name="renewal_reminder_days" value="<%= values.renewal_reminder_days %>" inputmode="numeric" required>
    </label>
    <label>Remind me to chase an overdue invoice every (days)
      <input type="text" name="overdue_followup_days" value="<%= values.overdue_followup_days %>" inputmode="numeric" required>
    </label>
    <label>Remind me to follow up a sent quote after (days)
      <input type="text" name="quote_followup_days" value="<%= values.quote_followup_days %>" inputmode="numeric" required>
    </label>
    <label>Remind me when a demo has been in client review for (days)
      <input type="text" name="demo_followup_days" value="<%= values.demo_followup_days %>" inputmode="numeric" required>
    </label>
  </div>

  <h2 id="checklist">Standard project checklist</h2>
  <p class="muted small-text">
    The steps every new project starts with. One step per line, written as <code>Stage name: step</code>.
    Stages: <%= pj.STAGES.map((s) => s.label).join(', ') %>. Changing this does not change projects that already exist.
  </p>
  <label>Steps
    <textarea name="project_checklist" rows="12" maxlength="6000"><%= values.project_checklist %></textarea>
  </label>

  <h2>WhatsApp messages</h2>
  <p class="muted small-text">
    Used by the WhatsApp buttons on quotes and invoices. These are filled in for you:
    <code>{name}</code> <code>{number}</code> <code>{total}</code> <code>{outstanding}</code> <code>{date}</code> <code>{due}</code>
    <code>{business}</code> <code>{bank}</code> (your banking details). Clear a box to go back to the standard wording.
  </p>
  <label>New invoice
    <textarea name="wa_invoice" rows="5" maxlength="1000"><%= values.wa_invoice %></textarea>
  </label>
  <label>Payment reminder
    <textarea name="wa_reminder" rows="5" maxlength="1000"><%= values.wa_reminder %></textarea>
  </label>
  <label>Thank-you once paid in full
    <textarea name="wa_receipt" rows="3" maxlength="1000"><%= values.wa_receipt %></textarea>
  </label>
  <label>Quote
    <textarea name="wa_quote" rows="3" maxlength="1000"><%= values.wa_quote %></textarea>
  </label>
  <p class="muted small-text">Project messages use <code>{name}</code> <code>{project}</code> <code>{link}</code> <code>{business}</code>.</p>
  <label>Demo is ready
    <textarea name="wa_demo" rows="4" maxlength="1000"><%= values.wa_demo %></textarea>
  </label>
  <label>Site is live
    <textarea name="wa_live" rows="3" maxlength="1000"><%= values.wa_live %></textarea>
  </label>
  <div class="actions"><button class="btn primary" type="submit">Save settings</button></div>
</form>

<form method="post" action="/settings/password" class="card form">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <h2>Change password</h2>
  <p class="muted">Signed in as <%= user.username %>. Changing the password signs out your other devices.</p>
  <div class="grid">
    <label>Current password
      <input type="password" name="current" autocomplete="current-password" required>
    </label>
    <label>New password (at least 10 characters)
      <input type="password" name="password" autocomplete="new-password" minlength="10" required>
    </label>
    <label>Repeat new password
      <input type="password" name="confirm" autocomplete="new-password" minlength="10" required>
    </label>
  </div>
  <div class="actions"><button class="btn" type="submit">Change password</button></div>
</form>

<p class="muted small-text">To show your logo on PDFs, save it as <code>logo.png</code> in the CRM's <code>data</code> folder.</p>
<%- include('partials/foot') %>
