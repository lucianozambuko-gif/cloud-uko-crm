<%- include('partials/head') %>
<div class="page-head"><h1>Settings</h1></div>

<form method="post" action="/settings" class="card form">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <h2>Business details (printed on quotes and invoices)</h2>
  <div class="grid">
    <label>Business name *
      <input type="text" name="business_name" value="<%= values.business_name %>" maxlength="120" required>
    </label>
    <label>Registration number
      <input type="text" name="business_reg_number" value="<%= values.business_reg_number %>" maxlength="40">
    </label>
    <label>Phone
      <input type="tel" name="business_phone" value="<%= values.business_phone %>" maxlength="40">
    </label>
    <label>Email
      <input type="email" name="business_email" value="<%= values.business_email %>" maxlength="160">
    </label>
    <label>Website
      <input type="text" name="business_website" value="<%= values.business_website %>" maxlength="160">
    </label>
  </div>
  <label>Address
    <textarea name="business_address" rows="3" maxlength="500"><%= values.business_address %></textarea>
  </label>

  <h2>VAT</h2>
  <label class="check-label">
    <input type="checkbox" name="vat_registered" value="1" <%= values.vat_registered === '1' ? 'checked' : '' %>> Cloud Uko is VAT registered (adds VAT to new quotes and invoices)
  </label>
  <div class="grid">
    <label>VAT number
      <input type="text" name="vat_number" value="<%= values.vat_number %>" maxlength="30">
    </label>
    <label>VAT rate (%)
      <input type="text" name="vat_rate" value="<%= values.vat_rate %>" inputmode="decimal">
    </label>
  </div>

  <h2>Numbering and terms</h2>
  <div class="grid">
    <label>Invoice prefix (e.g. CU-INV gives CU-INV-2026-001)
      <input type="text" name="invoice_prefix" value="<%= values.invoice_prefix %>" maxlength="12" required>
    </label>
    <label>Quote prefix
      <input type="text" name="quote_prefix" value="<%= values.quote_prefix %>" maxlength="12" required>
    </label>
    <label>Payment terms (days until an invoice is due)
      <input type="text" name="payment_terms_days" value="<%= values.payment_terms_days %>" inputmode="numeric" required>
    </label>
    <label>Quotes valid for (days)
      <input type="text" name="quote_valid_days" value="<%= values.quote_valid_days %>" inputmode="numeric" required>
    </label>
  </div>
  <label>Banking details (printed on invoices)
    <textarea name="bank_details" rows="4" maxlength="1000" placeholder="Bank, account name, account number, branch code"><%= values.bank_details %></textarea>
  </label>
  <label>Footer text (printed at the bottom of quotes and invoices)
    <textarea name="document_footer" rows="2" maxlength="1000"><%= values.document_footer %></textarea>
  </label>
  <div class="actions"><button class="btn primary" type="submit">Save settings</button></div>
</form>

<form method="post" action="/settings/password" class="card form">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <h2>Change password</h2>
  <p class="muted">Signed in as <%= user.username %>. Changing the password signs out your other devices.</p>
  <div class="grid">
    <label>Current password
      <input type="password" name="current" autocomplete="current-password" required>
    </label>
    <label>New password (at least 10 characters)
      <input type="password" name="password" autocomplete="new-password" minlength="10" required>
    </label>
    <label>Repeat new password
      <input type="password" name="confirm" autocomplete="new-password" minlength="10" required>
    </label>
  </div>
  <div class="actions"><button class="btn" type="submit">Change password</button></div>
</form>

<p class="muted small-text">To show your logo on PDFs, save it as <code>logo.png</code> in the CRM's <code>data</code> folder.</p>
<%- include('partials/foot') %>
